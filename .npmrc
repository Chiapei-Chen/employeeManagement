# npm 10 解析 vitest 的 peer dependency 時會出錯（Cannot read properties of null (reading 'edgesOut')）
legacy-peer-deps=true

# better-sqlite3 已附上各平台預先編譯的檔案（prebuilds/），但從 package-lock.json 安裝時，
# npm 會因為套件中有 binding.gyp 而自動執行 node-gyp 重新編譯，沒有 C++ 編譯工具的電腦就會失敗。
# 本專案的相依套件都不需要安裝腳本，所以直接關閉。（npm test / npm run 等指令不受影響）
ignore-scripts=true
