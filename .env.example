PORT=3000
# PostgreSQL 連線字串；本機可用 docker compose up -d 啟動（帳密見 docker-compose.yml）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/employee

# 正式環境請換成足夠長的隨機字串，例如：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# access token 有效秒數（放在前端記憶體，過期後前端會自動用 refresh token 換新的）
JWT_EXPIRES_IN=900
# refresh token 有效秒數（放在 HttpOnly cookie，前端 JS 讀不到）
JWT_REFRESH_EXPIRES_IN=604800
# cookie 是否加上 Secure（只經由 HTTPS 傳送）；未設定時 NODE_ENV=production 才為 true
# COOKIE_SECURE=true

# 啟動時若資料庫為空，寫入展示用帳號與員工資料。
# 未設定時預設為 false（展示帳號的密碼是公開的），本機展示才設為 true
SEED_DEMO_DATA=true

# 登入限流：每個 IP 在 TTL 內最多嘗試幾次（成功的登入也會計入）
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=60000
